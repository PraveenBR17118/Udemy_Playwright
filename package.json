  "type": "commonjs",
  "devDependencies": {
    "@azure/identity": "^4.13.2",
    "@azure/playwright": "^1.1.6",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.1.2",
    "allure-playwright": "^3.12.0"
  },
  "dependencies": {
    "allure-playwright": "^3.12.0",
    "exceljs": "^4.4.0"
